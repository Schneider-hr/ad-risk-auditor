<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>AD Risk Register — {{ domain }}</title>
<style>
  :root {
    --critical: #b30000; --high: #d9642c; --medium: #c9a227; --low: #4a7a3c;
    --bg: #f7f7f8; --card: #ffffff; --text: #1c1c1e; --muted: #6b6b70; --border: #e3e3e6;
  }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 32px; }
  .wrap { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 22px; margin-bottom: 4px; }
  .meta { color: var(--muted); font-size: 13px; margin-bottom: 24px; }
  .summary { display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap; }
  .stat { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 12px 18px; min-width: 110px; }
  .stat .n { font-size: 26px; font-weight: 700; }
  .stat .l { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .stat.critical .n { color: var(--critical); }
  .stat.high .n { color: var(--high); }
  .stat.medium .n { color: var(--medium); }
  .stat.low .n { color: var(--low); }
  .posture { background: var(--card); border: 1px solid var(--border); border-left: 4px solid var(--text); border-radius: 8px; padding: 14px 18px; margin-bottom: 28px; font-weight: 600; }
  .finding { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-bottom: 16px; border-left: 5px solid var(--border); }
  .finding.critical { border-left-color: var(--critical); }
  .finding.high { border-left-color: var(--high); }
  .finding.medium { border-left-color: var(--medium); }
  .finding.low { border-left-color: var(--low); }
  .finding h2 { font-size: 16px; margin: 0 0 6px; }
  .badge { display: inline-block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 2px 8px; border-radius: 4px; color: #fff; margin-right: 8px; }
  .badge.critical { background: var(--critical); }
  .badge.high { background: var(--high); }
  .badge.medium { background: var(--medium); }
  .badge.low { background: var(--low); }
  .risk-id { color: var(--muted); font-size: 12px; font-family: monospace; }
  .desc { margin: 10px 0; font-size: 14px; line-height: 1.5; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 13px; margin-top: 12px; }
  .grid div span.k { display: block; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .03em; margin-bottom: 2px; }
  .affected { font-size: 12px; color: var(--muted); margin-top: 10px; word-break: break-word; }
  .empty { text-align: center; color: var(--muted); padding: 40px; }
  footer { color: var(--muted); font-size: 12px; margin-top: 32px; text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Active Directory Risk Register</h1>
  <div class="meta">Domain: <strong>{{ domain }}</strong> &nbsp;·&nbsp; {{ users_scanned }} user objects scanned &nbsp;·&nbsp; Generated {{ generated_at }}</div>

  <div class="posture">Overall posture: {{ posture }}</div>

  <div class="summary">
    <div class="stat critical"><div class="n">{{ summary.Critical }}</div><div class="l">Critical</div></div>
    <div class="stat high"><div class="n">{{ summary.High }}</div><div class="l">High</div></div>
    <div class="stat medium"><div class="n">{{ summary.Medium }}</div><div class="l">Medium</div></div>
    <div class="stat low"><div class="n">{{ summary.Low }}</div><div class="l">Low</div></div>
  </div>

  {% if errors %}
  <div class="posture" style="border-left-color:var(--high);">{{ errors|length }} detector(s) reported an error during this run — see console output.</div>
  {% endif %}

  {% if findings %}
    {% for f in findings %}
    <div class="finding {{ rating_class[f.rating] }}">
      <span class="badge {{ rating_class[f.rating] }}">{{ f.rating }}</span>
      <span class="risk-id">{{ f.risk_id }}</span>
      <h2>{{ f.title }}</h2>
      <div class="desc">{{ f.description }}</div>
      <div class="grid">
        <div><span class="k">MITRE ATT&amp;CK</span>{{ f.mitre_attack }}</div>
        <div><span class="k">Control reference</span>{{ f.control_reference }}</div>
        <div><span class="k">Likelihood / Impact</span>{{ f.likelihood.name }} / {{ f.impact.name }}</div>
        <div><span class="k">Affected objects</span>{{ f.affected_count }}</div>
      </div>
      <div class="desc"><strong>Recommendation:</strong> {{ f.recommendation }}</div>
      <div class="affected">Affected: {{ f.affected_objects|join(', ') }}</div>
    </div>
    {% endfor %}
  {% else %}
    <div class="empty">No findings from this run.</div>
  {% endif %}

  <footer>Generated by AD Risk Auditor — github.com/Schneider-hr/ad-risk-auditor</footer>
</div>
</body>
</html>
